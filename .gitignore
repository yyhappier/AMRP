# Logs / runtime artifacts
logs/
*.log
*.log.*
runs/
wandb/
tb_logs/
mlruns/
# Training runtime logs (large, not tracked)
log/ms-swift_aw/**/train_*.log
# Keep eval scores and training progress txt logs
!log/
!log/eval_alce_score/
!log/eval_alce_score/**
!log/ms-swift_aw/
!log/ms-swift_aw/**/*.txt

# Keep ArmoRM 5-reward eval summaries & per-sample scores (small, needed for reporting).
# Only the two files below are un-ignored; responses.jsonl and eval_*.log stay ignored.
!logs/
!logs/ms-swift_aw/
!logs/ms-swift_aw/armo_reward_eval/
!logs/ms-swift_aw/armo_reward_eval/*/
!logs/ms-swift_aw/armo_reward_eval/*/summary.json
!logs/ms-swift_aw/armo_reward_eval/*/scores.jsonl
# Re-ignore raw generations (large, not needed for reporting).
logs/ms-swift_aw/armo_reward_eval/*/responses.jsonl

# Output / plots / temp
plots/
outputs/
tmp/
temp/

